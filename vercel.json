{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "ClientApp/dist",
  "rewrites": [
    { "source": "/tour-a/ruleta", "destination": "/" },
    { "source": "/tour-c/ruleta", "destination": "/" },
    {
      "source": "/api/(.*)",
      "destination": "https://tour-virtual-banreservas-api.onrender.com/api/$1"
    },
    {
      "source": "/tour-a",
      "destination": "/"
    },
    {
      "source": "/tour-c",
      "destination": "/"
    }
  ]
}
